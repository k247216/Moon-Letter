# Copy to .env on the ECS host. Never commit the filled file.
# The domain must already resolve to this ECS instance for automatic HTTPS.
MOON_LETTER_DOMAIN=letter.example.com

# PostgreSQL and application secrets. Generate long random values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret

# Alibaba Cloud OSS S3-compatible endpoint for the bucket's region.
# Example: https://oss-cn-shanghai.aliyuncs.com
S3_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
S3_REGION=oss-cn-shanghai
S3_BUCKET=replace-with-a-private-bucket
S3_ACCESS_KEY=replace-with-a-dedicated-ram-access-key
S3_SECRET_KEY=replace-with-the-ram-secret
S3_PATH_STYLE_ACCESS=false

# Used by scripts/backup.sh when backups should also be copied to OSS.
# Example: oss://your-private-bucket/backups/moon-letter
MOON_LETTER_OSS_URI=oss://replace-with-a-private-bucket/backups/moon-letter
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=oss-cn-shanghai
OSS_ACCESS_KEY_ID=replace-with-the-ram-access-key
OSS_ACCESS_KEY_SECRET=replace-with-the-ram-secret
